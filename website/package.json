{
  "name": "course-notes-website",
  "private": true,
  "description": "Client-side scripts for the course notes website (TypeScript, bundled with esbuild).",
  "scripts": {
    "build": "esbuild src/app.ts src/notes.ts src/ink.ts src/nav.ts --bundle --format=iife --target=es2019 --minify --sourcemap --outdir=dist",
    "typecheck": "tsc --noEmit",
    "check-math": "node check_math.mjs"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "katex": "0.16.9",
    "typescript": "5.4.5"
  }
}
